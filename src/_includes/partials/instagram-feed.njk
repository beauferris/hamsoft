<section class="instagram-feed-section">
  <div class="govuk-width-container">
    <h2 class="govuk-heading-l">Follow Us on Instagram</h2>
    {% if site.instagram_handle %}
      <p class="govuk-body">
        <a href="https://www.instagram.com/{{ site.instagram_handle }}/" target="_blank" rel="noopener noreferrer" class="govuk-link">
          @{{ site.instagram_handle }}
        </a>
      </p>
    {% endif %}
    
    <div class="instagram-feed-container">
      {% if instagram_widget_code %}
        {# Use custom widget code from third-party service #}
        {{ instagram_widget_code | safe }}
      {% else %}
        {# Default: Placeholder for widget embed #}
        {# 
          TO USE: Replace this section with embed code from:
          - SnapWidget: https://snapwidget.com/
          - Juicer: https://www.juicer.io/
          - Elfsight: https://elfsight.com/
          
          Example SnapWidget code:
          <script src="https://snapwidget.com/js/snapwidget.js"></script>
          <iframe src="https://snapwidget.com/embed/..." ...></iframe>
        #}
        <div class="instagram-feed-placeholder">
          <p class="govuk-body">Add your Instagram widget embed code here.</p>
          <p class="govuk-body-s">
            See <code>INSTAGRAM_FEED_SETUP.md</code> for setup instructions.
          </p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .instagram-feed-section {
    padding: 50px 0;
    background-color: #fafafa;
  }
  
  .instagram-feed-container {
    margin-top: 30px;
  }
  
  .instagram-feed-container iframe {
    width: 100%;
    max-width: 100%;
    border: none;
  }
  
  .instagram-feed-placeholder {
    text-align: center;
    padding: 60px 20px;
    background: white;
    border-radius: 8px;
    border: 2px dashed #ccc;
  }
  
  .instagram-feed-placeholder code {
    background: #f3f2f1;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.9em;
  }
</style>

