{% if collections.reviews and collections.reviews.length > 0 %}
<div class="review-cards">
  <div class="govuk-width-container">
    <div class="review-cards__grid">
      {% for review in collections.reviews %}
        <div class="review-card">
          <p class="review-card__body">{{ review.data.body }}</p>
          <p class="review-card__client">{{ review.data.client }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}

