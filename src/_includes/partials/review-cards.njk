{% set isSlider = slider | default(false) %}
{% set sliderId = "review-slider-" + (collections.reviews | length | default(0)) %}

{% if collections.reviews and collections.reviews.length > 0 %}
<section class="grey-section{% if isSlider %} review-section--slider{% endif %}">
<div class="review-cards">

  {% if isSlider %}
    <div class="card-slider-wrapper">
      <div class="govuk-width-container">
        <h2 class="govuk-heading-l"> Happy Clients </h2>
      </div>
      <div class="card-slider" data-slider-id="{{ sliderId }}" tabindex="0">
        <button class="card-slider__control card-slider__control--prev" aria-label="Previous review" type="button">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="card-slider__viewport">
          <div class="card-slider__track">
            {% for review in collections.reviews %}
              <div class="card-slider__slide{% if loop.first %} is-active{% endif %}" data-index="{{ loop.index0 }}" aria-hidden="{% if loop.first %}false{% else %}true{% endif %}">
                <div class="govuk-width-container">
                  <div class="card-slider__slide-content">
                    <div class="review-card">
                      <div class="review-card__body">
                        {% if review.data.body %}
                          {{ review.data.body | markdown | safe }}
                        {% else %}
                          {{ review.templateContent | safe }}
                        {% endif %}
                      </div>
                      <p class="review-card__client">- {{ review.data.client }}</p>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <button class="card-slider__control card-slider__control--next" aria-label="Next review" type="button">
          <span aria-hidden="true">›</span>
        </button>
      </div>
      <div class="govuk-width-container">
        <div class="review-cards__action">
          <a href="/contact/" class="govuk-button">Leave a review</a>
        </div>
      </div>
    </div>
  {% else %}
    <div class="govuk-width-container">
      <h2 class="govuk-heading-l"> Happy Clients </h2>
      <div class="review-cards__grid">
        {% for review in collections.reviews %}
          <div class="review-card">
            <div class="review-card__body">
              {% if review.data.body %}
                {{ review.data.body | markdown | safe }}
              {% else %}
                {{ review.templateContent | safe }}
              {% endif %}
            </div>
            <p class="review-card__client">- {{ review.data.client }}</p>
          </div>
        {% endfor %}
      </div>
      <div class="review-cards__action">
        <a href="/contact/" class="govuk-button">Leave a review</a>
      </div>
    </div>
  {% endif %}
</div>
</section>
{% endif %}

