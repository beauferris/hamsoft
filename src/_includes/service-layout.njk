<!DOCTYPE html>
<html lang="en" class="govuk-template">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8"/>

    {% set metaDescription = seo.description or description or summary or site.description %}
    {% set siteName = site.name %}
    {% set robots = robots or "index,follow" %}

    <title>{{ siteName ~ " | " ~ (metaTitle or title) }}</title>
    <meta name="description" content="{{ metaDescription}}">
    <meta name="robots" content="{{ robots }}">

    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:type" content="{{ seo.type or 'website' }}">
    {% set ogImage = seo.image or image_url %}
    {% if ogImage %}
      {% set absoluteOgImage = ogImage %}
      {% if not ogImage.startsWith("http") %}
        {% set absoluteOgImage = site.url + ogImage %}
      {% endif %}
      <meta property="og:image" content="{{ absoluteOgImage }}">
      <meta property="og:image:alt" content="{{ title | striptags }}">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content="{{ absoluteOgImage }}">
    {% endif %}

    <link rel="preload" href="/assets/fonts/raleway-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/assets/fonts/raleway-bold.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/assets/fonts/open-sans-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/assets/fonts/open-sans-bold.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/styles.css"/>
    <link rel="preload" href="/assets/images/logo-2.png" as="image" fetchpriority="high">
  </head>

  <body class="govuk-template__body">

    {% if landing_layout %}
      {% include "partials/landing-" + landing_layout + ".njk" %}
    {% else %}
      {% include "partials/landing-default.njk" %}
    {% endif %}
   
    <main class="govuk-main-wrapper" id="main-content">
      <div class="govuk-width-container">
     

        <article class="blog-content service-content">
          {{ content | safe }}
        </article>

      </div>
    </main>
  
    <script src="/scripts/main.js" defer></script>
  </body>
  {% include "partials/footer.njk" %}
</html>



